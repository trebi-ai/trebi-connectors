{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The data of a comment event.",
  "required": [
    "repository",
    "action",
    "number"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "description": "The repository as owner/name."
    },
    "action": {
      "type": "string",
      "description": "What happened, for example opened or closed."
    },
    "number": {
      "type": "integer",
      "description": "The number of the issue or the pull request."
    },
    "title": {
      "type": "string",
      "description": "The title of the issue or the pull request."
    },
    "url": {
      "type": "string",
      "description": "The page of the comment."
    },
    "author": {
      "type": "string",
      "description": "The login of the author."
    },
    "body": {
      "type": "string",
      "description": "The text of the comment."
    },
    "is_pull_request": {
      "type": "boolean",
      "description": "True when the comment is on a pull request."
    }
  }
}
