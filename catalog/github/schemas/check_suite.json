{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The data of a check suite event.",
  "required": [
    "repository",
    "action"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "description": "The repository as owner/name."
    },
    "action": {
      "type": "string",
      "description": "What happened, for example completed."
    },
    "url": {
      "type": "string",
      "description": "The checks page of the commit."
    },
    "suite_id": {
      "type": "integer",
      "description": "The id of the check suite."
    },
    "app": {
      "type": "string",
      "description": "The name of the service that runs the checks."
    },
    "status": {
      "type": "string",
      "description": "queued, in_progress, or completed."
    },
    "conclusion": {
      "type": "string",
      "description": "success, failure, or another result when the checks are completed."
    },
    "branch": {
      "type": "string",
      "description": "The branch of the commit."
    },
    "head": {
      "type": "string",
      "description": "The SHA of the commit."
    },
    "number": {
      "type": "integer",
      "description": "The number of the first pull request of the commit."
    }
  }
}
