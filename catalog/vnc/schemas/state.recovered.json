{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "The data of a state.recovered event: Trebi can reach the computer again.",
  "required": [
    "key",
    "old",
    "new",
    "threshold"
  ],
  "properties": {
    "key": {
      "type": "string",
      "description": "reachable."
    },
    "old": {
      "type": [
        "number",
        "null"
      ],
      "description": "The value before: 1 or 0, or null at the first check."
    },
    "new": {
      "type": "number",
      "description": "The value now: 1 when Trebi can reach the computer, else 0."
    },
    "threshold": {
      "type": "object",
      "required": [
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "above",
            "below"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "description": "The limit: below 1."
    }
  }
}
