{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.trebi.ai/schema/trebi-connector.schema.json",
  "title": "trebi-connector.yaml",
  "description": "The manifest of one Trebi connector (trebi-connector/1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "title", "description", "version"],
  "anyOf": [
    {"required": ["actions"]},
    {"required": ["events"]},
    {"required": ["channel"]}
  ],
  "properties": {
    "schema": {"const": "trebi-connector/1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "not": {"enum": ["email", "webhook", "trebi"]}},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "icon": {"type": "string"},
    "version": {"$ref": "#/$defs/semver"},
    "publisher": {"enum": ["trebi", "community"]},
    "source": {"type": "string"},
    "homepage": {"type": "string"},
    "license": {"type": "string"},
    "warning": {"type": "string"},
    "platforms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9]+$"}
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": {"type": "boolean"},
        "github_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "tag", "asset"],
          "properties": {
            "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "tag": {"type": "string", "minLength": 1},
            "asset": {"type": "string", "minLength": 1},
            "checksums": {"type": "string"}
          }
        },
        "brew": {"type": "string"},
        "go": {"type": "string"},
        "bin": {"type": "string"},
        "version_command": {"type": "string"},
        "packslip": {}
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "label": {"type": "string"},
              "help": {"type": "string"},
              "url": {"type": "string"},
              "secret": {"type": "boolean"},
              "required": {"type": "boolean"},
              "choices": {"type": "array", "items": {"type": "string"}},
              "default": {"type": "string"},
              "format": {"type": "string"}
            }
          }
        },
        "login": {
          "type": "array",
          "items": {"enum": ["qr", "device_code", "url", "input", "wait"]}
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "compat": {"type": "string"}
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands"],
          "properties": {
            "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {"type": "string"},
            "name": {"type": "string"},
            "version": {"type": "string"},
            "command": {"type": "string"},
            "args": {"type": "array", "items": {"type": "string"}},
            "env": {"$ref": "#/$defs/stringMap"},
            "url": {"type": "string"},
            "headers": {"$ref": "#/$defs/stringMap"}
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "protocol": {"enum": ["lines", "trebi-connector/1"]},
        "command": {"type": "string", "minLength": 1},
        "restart": {"enum": ["always", "on-failure", "never"]},
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
              "description": {"type": "string"},
              "schema": {"type": "string"}
            }
          }
        },
        "format": {"enum": ["json", "line"]},
        "poll": {"type": "string"},
        "id": {"type": "string"},
        "ts": {"type": "string"},
        "identity": {"type": "string"},
        "catchup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "max_events": {"type": "integer", "minimum": 0},
            "timeout": {"type": "string"}
          }
        },
        "subscriptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "modes"],
          "properties": {
            "action": {"type": "string", "minLength": 1, "maxLength": 40},
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["api", "manual", "stream", "poll"]}
            },
            "fields": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "label"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
                  "label": {"type": "string", "minLength": 1},
                  "help": {"type": "string"},
                  "choices": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "dynamic": {"type": "boolean"},
                  "multiple": {"type": "boolean"},
                  "required": {"type": "boolean"},
                  "default": {"type": "string"},
                  "room": {"type": "boolean"}
                }
              }
            },
            "webhook": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "headers": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}
                },
                "handshake": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"type": "string", "pattern": "^(query_echo:[A-Za-z0-9_.]{1,64}|json_echo:[A-Za-z0-9_]{1,64}|header_echo:[a-z0-9-]{1,64}|ok:(GET|HEAD))$"}
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "enum": ["rooms.list", "rooms.open", "threads", "threads.create", "history", "replay", "typing", "seen", "reactions", "edit", "attachments.in", "attachments.out", "replies"]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_text": {"type": "integer", "minimum": 1},
            "formats": {"type": "array", "items": {"enum": ["text", "markdown", "html"]}}
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "command"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "readonly": {"type": "boolean"},
        "default": {"enum": ["on", "ask", "off"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stdin": {"enum": ["json", "none"]},
        "output": {"enum": ["json", "csv", "text"]},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "object"},
            "properties": {
              "type": "object",
              "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,31}$"},
              "additionalProperties": {"$ref": "#/$defs/inputField"}
            },
            "required": {"type": "array", "items": {"type": "string"}}
          }
        },
        "expand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "each"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "each": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "env": {"$ref": "#/$defs/stringMap"},
        "timeout": {"type": "string"}
      }
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
        "description": {"type": "string"},
        "enum": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "maxLength": {"type": "integer", "minimum": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "items": {"$ref": "#/$defs/inputField"}
      }
    }
  }
}
