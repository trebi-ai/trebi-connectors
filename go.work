go 1.26.0

use (
	./sdk
	./src/discord-cli
	./src/whatsapp-cli
)

// The CLIs build against the SDK in this commit, also before its tag
// exists. Keep the version equal to the SDK require in src/*/go.mod.
// go install ignores this file and reads the tag.
replace github.com/trebi-ai/trebi-connectors/sdk v0.1.0 => ./sdk
